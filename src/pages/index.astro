---
import { getEntry } from "astro:content";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import Presentation from "../components/Presentation.astro";
import Languages from "../components/Languages.astro";

const about = await getEntry("pages", "about");
---

<Layout>
  <Header />

  <main>
    {about && <Presentation entry={about} id="about" />}
    <Languages />
  </main>

  <footer id="contact" class="mt-16 scroll-mt-8 border-t border-line pt-6">
    <h2 class="text-xs font-medium tracking-[0.2em] text-accent-dim uppercase">Contact Me</h2>
    <p class="mt-2 text-sm text-muted">
      The fastest way to reach me is email. Replace this block with your real details.
    </p>
    <p class="mt-2 text-sm">
      <a href="mailto:hello@example.com" class="text-accent underline underline-offset-2"
        >hello@example.com</a
      >
    </p>
  </footer>
</Layout>